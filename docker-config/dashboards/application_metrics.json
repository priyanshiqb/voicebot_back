        },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "pg_database_size_bytes{datname=\"voicebot_db\"}",
          "legendFormat": "DB Size",
          "refId": "A"
        }
