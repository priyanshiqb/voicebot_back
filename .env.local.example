# =============================================================================
#  .env.local  —  HOST overrides for running Django OUTSIDE Docker
# -----------------------------------------------------------------------------
#  Copy to `.env.local`. Never commit the real file.
#
#  WHAT THIS FILE IS FOR
#    `.env` is written for the Docker network: it points at service NAMES
#    (pgbouncer, redis, backend-dev) on their IN-CONTAINER ports. None of those
#    resolve from your host. This file re-points exactly those keys at
#    127.0.0.1 and the PUBLISHED ports, and nothing else.
#
#    So it stays SHORT on purpose — 4 keys are mandatory, the rest are optional.
#    Everything you do not list here falls through to `.env`, which is the point:
#    one place to change a password, not two.
#
#    The infrastructure still runs in Docker. This file is for the case where
#    only Django (runserver / celery / manage.py) runs on the host:
#      docker compose up -d          # postgres, pgbouncer, redis, azurite, ...
#      uv run python manage.py runserver
#
#  LOAD ORDER (config/settings/base.py, lines 14-26)
#    1. `.env.local`  (this file)  ← read FIRST
#    2. `.env`                     ← read SECOND
#    django-environ KEEPS THE FIRST VALUE IT SEES, so every key here WINS over
#    the same key in `.env`. A key absent here simply comes from `.env`.
#
#  SYNTAX RULES
#    - Keep every comment on its OWN line. django-environ folds a trailing
#      "VALUE  # note" into the value itself.
#    - No spaces around `=`.
#
#  ANNOTATION LEGEND
#    [if omitted: X]  What `.env` supplies instead, and what that breaks. This
#                     is the analogue of a settings default — omit the line and
#                     X is what the app actually gets.
#    [SECRET]         Replace before use.
# =============================================================================



# #############################################################################
#
#   SECTION 1  —  MANDATORY (4 keys)
#
#   Without these the process cannot reach its own datastores. These are the
#   only four that are always required for a host run.
#
# #############################################################################

# -----------------------------------------------------------------------------
#  1.1  PostgreSQL — reach it on the published port instead of the compose network
# -----------------------------------------------------------------------------
# [if omitted: `pgbouncer`] -> "could not translate host name" at the first
# query, so every request 500s and `manage.py migrate` cannot start. `pgbouncer`
# is a Docker service name and exists only on the compose network.
# Values: 127.0.0.1 for the containerised database
#         (or the host/IP of a real Postgres you run natively)
# Example: 127.0.0.1
POSTGRES_HOST=127.0.0.1

# [if omitted: 5432] -> connection refused, unless you happen to run a native
# Postgres on 5432 — in which case it is WORSE: you silently connect to the
# wrong database. 5432 is the IN-CONTAINER port; from the host you must use the
# PUBLISHED one, which `.env` calls DB_PORT.
# Values: must equal DB_PORT in `.env` (5579 by default).
# Example: 5579
POSTGRES_PORT=5579

# -----------------------------------------------------------------------------
#  1.2  Redis — cache, channel layer, Celery broker, django-defender counters
# -----------------------------------------------------------------------------
# [if omitted: `redis`] -> name does not resolve from the host.
# Values: 127.0.0.1 for the containerised Redis.
# Example: 127.0.0.1
REDIS_HOST=127.0.0.1

# [if omitted: 6379] -> connection refused. 6379 is the in-container port; the
# host mapping is REDIS_EXTERNAL_PORT in `.env`.
# This one fails in a confusing place: django-defender counts failed logins in
# Redis, so a wrong port takes the LOGIN endpoint down with a 500 while much of
# the rest of the app still appears to work.
# Values: must equal REDIS_EXTERNAL_PORT in `.env` (5563 by default).
# Example: 5563
REDIS_PORT=5563

# Celery needs no entry here: CELERY_BROKER_URL and CELERY_RESULT_BACKEND are
# not set in `.env`, so settings derives them from the two keys above and a host
# worker follows automatically.
# WATCH OUT: if anyone ever adds an explicit CELERY_BROKER_URL to `.env`, it
# will read redis://redis:6379/2 and host workers will break. Then — and only
# then — add both lines here:
# CELERY_BROKER_URL=redis://127.0.0.1:5563/2
# CELERY_RESULT_BACKEND=redis://127.0.0.1:5563/2



# #############################################################################
#
#   SECTION 2  —  CONDITIONAL
#
#   Needed only if you use the feature. Each says when.
#
# #############################################################################

# -----------------------------------------------------------------------------
#  2.1  ETL callback address  — needed if you exercise knowledge-base ingestion
# -----------------------------------------------------------------------------
# [if omitted: http://backend-dev:8000] -> the ETL service tries to call back
# into a container that is not running your code, so ingestion jobs finish
# without ever reporting their result and documents sit in PROCESSING forever.
# This must be the address of YOUR host process as seen FROM the ETL service:
#   - ETL also on the host          -> http://127.0.0.1:8000
#   - ETL in Docker, backend host   -> http://host.docker.internal:8000
#   - ETL remote                    -> a publicly reachable URL or tunnel
# Values: absolute URL, no trailing slash.
# Example: http://127.0.0.1:8000
CALLBACK_URL_BASE=http://127.0.0.1:8000

# ETL_SERVER_URL normally needs NO override: `.env` already points at
# http://localhost:5001/api/v1/etl/, which is correct from the host.

# -----------------------------------------------------------------------------
#  2.2  Object storage — Azurite on the published port
# -----------------------------------------------------------------------------
# Only the endpoint differs from `.env`. The account name, key and container are
# identical, so they stay where they are — the two lines below are the whole
# override.
#
# `.env` addresses Azurite as `azurite:10000`, which only resolves inside the
# compose network. From the host it is the published AZURITE_BLOB_PORT. Both the
# connection string (how Django reaches Azurite) and the public endpoint (what a
# browser is handed in a SAS URL) have to move.
#
# Note the difference between omitting a key and blanking it. Omit one and it
# falls through to `.env`, which is usually what you want. Set one to an EMPTY
# value and it is worse than either — USE_AZURE_STORAGE flips to False and
# Django silently stores uploads on local disk under ./media, so nothing errors
# and every file lands somewhere you did not expect.
#
# AZURE_CONNECTION_STRING="DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;"
# AZURE_PUBLIC_ENDPOINT="http://127.0.0.1:10000"




# #############################################################################
#
#   SECTION 3  —  OPTIONAL CONVENIENCES
#
#   All commented out. Uncomment individually; none is needed for a host run.
#
# #############################################################################

# ---- Stop sending real email from your laptop -------------------------------
# [if omitted: the SMTP backend from `.env`] -> password resets and signup OTPs
# are genuinely delivered through the platform Gmail account. The console
# backend prints them to your terminal instead, which is also the fastest way to
# read an OTP during development.
# Values: django.core.mail.backends.console.EmailBackend  print to stdout
#         django.core.mail.backends.locmem.EmailBackend   swallow silently
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# ---- Tenant SMTP against MailHog / Mailpit on localhost ----------------------
# [if omitted: False] -> tenant SMTP hosts resolving to loopback or private
# addresses are rejected, because tenants supply the hostname the app dials and
# that is SSRF by design. Turn this on ONLY to test against a local mail catcher.
# production.py pins it False and ignores the variable entirely.
# Values: True | False
# TENANT_SMTP_ALLOW_PRIVATE_HOSTS=True

# ---- Google Calendar OAuth without the shared tunnel -------------------------
# [if omitted: the public tunnel URL from `.env`] -> the OAuth round trip ends
# at whatever that tunnel points to, which may not be your process. Point it at
# localhost instead — and add the exact same string to the Authorised redirect
# URIs in the Google console, or the callback fails with redirect_uri_mismatch.
# Values: $BACKEND_PROJECT_URL + /api/v1/core/calendar-integrations/callback/
# GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/api/v1/core/calendar-integrations/callback/

# [if omitted: the webhook URL from `.env`] -> Google keeps pushing calendar
# changes to that address rather than to you. Blank disables push and falls back
# to on-demand free/busy, which still works and needs no tunnel. To receive them
# locally you need a PUBLIC https tunnel (ngrok, VS Code Dev Tunnels).
# Values: absolute https:// URL, or empty to disable.
# GOOGLE_CALENDAR_WEBHOOK_URL=

# ---- A throwaway calendar-token encryption key -------------------------------
# [if omitted: the key from `.env`] -> your host process shares the shared key,
# which is usually what you want (tokens stay decryptable both ways). Set your
# own only to isolate local tokens — anything already encrypted with the other
# key then becomes undecryptable and those tenants must reconnect.
# Generate: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Values: a 44-character url-safe base64 Fernet key. [SECRET]
# SCHEDULING_TOKEN_ENCRYPTION_KEY=

# ---- Firebase push from the host --------------------------------------------
# [if omitted: empty in `.env`] -> push sends are silent no-ops. A container
# mount path will not exist on your host, so set a host path if you need push.
# Values: absolute or repo-relative path to the service-account .json
# FIREBASE_CREDENTIALS=./secrets/firebase-service-account.json

# ---- Settings module ---------------------------------------------------------
# [if omitted: config.settings.local from `.env`] -> already correct on a dev
# box. Only set this if your `.env` is a production one, or to run the suite
# against real Postgres:
#   uv run python manage.py test core --settings=config.settings.test_postgres
# (that flag is the normal way — this key is the fallback when you cannot pass one)
# Values: config.settings.local | config.settings.test_postgres | config.settings.production
# DJANGO_SETTINGS_MODULE=config.settings.local



# #############################################################################
#
#   DO NOT COPY THESE HERE
#
#   Duplicating a key that is IDENTICAL in `.env` creates two places to change
#   one value, and the copy silently wins. These are the ones people add out of
#   habit — every one of them is already correct in `.env`:
#
#     POSTGRES_DB, POSTGRES_USER, POSTGRES_PASSWORD
#         The credentials are the same whether you connect through the compose
#         network or the published port. Only HOST and PORT change.
#         (Exception: you run a NATIVE Postgres with different credentials —
#         then all three belong here, and POSTGRES_PORT is probably 5432.)
#
#     AZURE_ACCOUNT_NAME, AZURE_ACCOUNT_KEY, AZURE_CONTAINER
#         Azurite's development account is the same whether you reach it through
#         the compose network or the published port. Only the endpoint changes,
#         which is what section 2.2 overrides.
#
#     DJANGO_SECRET_KEY, BACKEND_PROJECT_URL, FRONTEND_PROJECT_URL,
#     DJANGO_ALLOWED_HOSTS, EMAIL_*, RAZORPAY_*, ETL_SERVER_URL, and every
#     tuning ceiling (CATALOG_*, CONTACT_*, CAMPAIGN_*, BOOKING_*, *_RETENTION_*)
#         None of these differ between host and container.
#
#     ENV_FILE
#         Inert here. base.py reads it from the PROCESS environment (line 15) to
#         decide which override file to open, which happens before this file is
#         parsed — so a value inside it arrives too late to have any effect.
#         It already defaults to `.env.local`, so a plain host run needs nothing.
#         To point at a different file, export it in your shell:
#             ENV_FILE=.env.myenv uv run python manage.py runserver
#
#     Anything from section 1 of `.env` (COMPOSE_*, *_PORT, *_BIND_IP, DOMAIN,
#     SCHEME, GF_*, PGADMIN_*, GATEWAY_*)
#         Those are read by docker compose, never by Django. Compose does not
#         read this file at all — it only reads `.env`.
#
# #############################################################################

# --- Razorpay -----------------------------------------------------------------
# All three have NO default in settings: an unset credential stops Django from
# booting rather than silently disabling signature verification, which is what the
# old "rzp_test_dummykey" default did.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# The webhook signing secret from the Razorpay dashboard. Required whenever
# PAYMENTS_ALLOW_UNSIGNED is False — without it every genuine webhook is rejected.
RAZORPAY_WEBHOOK_SECRET=

# Accept payment callbacks without verifying their signature, and stub order
# creation. True is correct for local development and required by the test suite.
# NEVER set this outside a dev box: production settings raise ImproperlyConfigured
# on it, and `manage.py check` reports onboard.E001 whenever DEBUG is False.
PAYMENTS_ALLOW_UNSIGNED=True
