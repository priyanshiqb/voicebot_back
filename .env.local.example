# =============================================================================
#  .env.local  —  LOCAL host overrides (running Django OUTSIDE Docker)
# -----------------------------------------------------------------------------
#  Copy to `.env.local`.
#
#  Load order (config/settings/base.py): this file is read FIRST, then `.env`.
#  django-environ keeps the FIRST value it sees, so every key here OVERRIDES the
#  same key in `.env`. Only the keys that differ when the app runs on the HOST
#  (not in Docker) belong here — everything else falls through to `.env`.
#
#  Keep comments on their own line. Never commit the real `.env.local`.
# =============================================================================

# Which env file this is + which settings module to load.
ENV_FILE=.env.local
DJANGO_SETTINGS_MODULE=config.settings.local

# ---- Database — point at the host-exposed Postgres port ----
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5579
POSTGRES_DB=voicebot_db
POSTGRES_USER=postgres
# [SECRET]
POSTGRES_PASSWORD=change-me

# ---- Redis — point at the host-exposed Redis ----
REDIS_HOST=127.0.0.1
# NOTE: the in-container port is 6379, but Docker exposes Redis on the host at
# REDIS_EXTERNAL_PORT (5563). For host-side runs use 5563:
REDIS_PORT=5563

# ---- Local callback base (host-reachable backend URL) ----
CALLBACK_URL_BASE=http://127.0.0.1:8000

# ---- Object storage (local MinIO on the host) ----
S3_ENDPOINT_URL="http://127.0.0.1:9000"
S3_ACCESS_KEY_ID="minioadmin"
# [SECRET] (MinIO default is "minioadmin"; change if you changed it)
S3_SECRET_ACCESS_KEY=change-me
S3_BUCKET_NAME="voicebot-local-bucket"
S3_REGION_NAME="us-east-1"


# =============================================================================
#  Optional local overrides (uncomment as needed) — these fall through to .env
#  otherwise. Handy when developing calendar features on the host.
# =============================================================================
# Print emails to the console instead of sending:
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
#
# Local calendar-token encryption key (generate a throwaway):
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SCHEDULING_TOKEN_ENCRYPTION_KEY=
#
# Real-time calendar sync needs a PUBLIC https tunnel (ngrok / VS Code Dev Tunnels):
# GOOGLE_CALENDAR_WEBHOOK_URL=https://<your-tunnel>/api/v1/core/calendar-webhook/google/
# MICROSOFT_CALENDAR_WEBHOOK_URL=https://<your-tunnel>/api/v1/core/calendar-webhook/microsoft/
