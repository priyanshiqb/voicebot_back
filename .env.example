# =============================================================================
#  .env  —  BASE / SHARED environment configuration (app + Docker stack)
# -----------------------------------------------------------------------------
#  Copy to `.env` and fill in real values (SECRET values are shown as
#  "change-me..." placeholders below — replace every one).
#
#  Load order (config/settings/base.py): `.env.local` is read FIRST, then `.env`.
#  django-environ keeps the first value it sees, so any key also present in
#  `.env.local` OVERRIDES the value here (see `.env.local.example`).
#
#  Keep comments on their OWN line — django-environ can fold a trailing "# ..."
#  into the value. Never commit the real `.env`.
# =============================================================================


# =============================================================================
#  1. Container / Docker stack
# =============================================================================
# Compose project name + which service profiles to bring up.
COMPOSE_PROJECT_NAME=voicebot_back
COMPOSE_PROFILES=dev,database,pgbouncer,caches,grafana,logs-monitoring,matrics-monitoring,emulators,backend-docs

# Allow all CORS origins (dev convenience; keep off in prod).
CORS_ALLOW_ALL_ORIGINS=True

# ---- Gateway & domain ----
SCHEME="http://"
DOMAIN=localhost
ENV_NAME=dev
# Backend container hostnames used by the gateway.
WSGI_HOST=backend-dev
ASGI_HOST=backend-dev
# Email for ACME / Let's Encrypt certificate registration.
ACME_EMAIL=admin@example.com

# ---- Database (Postgres / pgbouncer) ----
# Host-exposed Postgres port.
DB_PORT=5579
# In-container Postgres port.
POSTGRES_PORT=5432
# In Docker this is the pgbouncer/db service name; on the host use 127.0.0.1 (.env.local).
POSTGRES_HOST=pgbouncer
POSTGRES_DB=voicebot_db
POSTGRES_USER=postgres
# [SECRET]
POSTGRES_PASSWORD=change-me

# ---- pgAdmin ----
PGADMIN_PORT=5560
PGADMIN_EMAIL=admin@example.com
# [SECRET]
PGADMIN_PASSWORD=change-me

# ---- Redis ----
REDIS_HOST=redis
# In-container Redis port.
REDIS_PORT=6379
# Host-exposed Redis port (host-side app runs use this — see .env.local.example).
REDIS_EXTERNAL_PORT=5563
REDIS_INSIGHT_PORT=5561

# ---- App server ports ----
DAPHNE_PORT=8000
WSGI_PORT=8001
ASGI_PORT=8002
DOCS_PORT=8088
# Interface docker publishes ports on (127.0.0.1 = localhost only).
BIND_IP=127.0.0.1

# ---- Grafana / Loki / Prometheus (observability) ----
GF_SECURITY_ADMIN_USER=admin
# [SECRET]
GF_SECURITY_ADMIN_PASSWORD=change-me
GRAFANA_PORT=3099
LOKI_PORT=3100
LOKI_RETENTION_PERIOD=720h
PROMETHEUS_PORT=9090

# ---- Gateway basic auth ----
GATEWAY_BASIC_AUTH_USER=admin
# [SECRET] bcrypt hash. In docker-compose each "$" MUST be escaped as "$$".
GATEWAY_BASIC_AUTH_PASSWORD_HASH=change-me-escaped-bcrypt-hash

# ---- MinIO (S3 emulator) ports ----
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001


# =============================================================================
#  2. Django & application settings
# =============================================================================
# Settings module: config.settings.local | .production | .base
DJANGO_SETTINGS_MODULE=config.settings.local
# Keep False everywhere except local/dev.
DJANGO_DEBUG=True
# [SECRET] Generate: python -c "import secrets;print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,*
DJANGO_JSON_LOGGING=False
DJANGO_SIMPLE_LOGGING=True

# Public base URLs.
BACKEND_PROJECT_URL=http://localhost:8000
FRONTEND_PROJECT_URL=http://localhost:3000
# Optional. Default = FRONTEND_PROJECT_URL / +BACKEND for CSRF. Comma-separated.
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# ---- Email (SMTP) ----
EMAIL_BACKEND='django.core.mail.backends.smtp.EmailBackend'
EMAIL_HOST='smtp.gmail.com'
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER='you@example.com'
EMAIL_SENDER_NAME='Voicebot'
# [SECRET] SMTP / app password.
EMAIL_HOST_PASSWORD=change-me

# ---- Payments (Razorpay) ----
RAZORPAY_KEY_ID='rzp_test_xxxxxxxxxxxxxx'
# [SECRET]
RAZORPAY_KEY_SECRET=change-me

# ---- Security / misc ----
RECAPTCHA_VERIFICATION_ON=True
# Minutes an OTP stays valid (optional; default 2).
OTP_VALIDITY_MINUTES=2

# ---- ETL / RAG service ----
ETL_SERVER_URL=http://localhost:5001/api/v1/etl/
# [SECRET]
ETL_SYSTEM_TOKEN=dummy_etl_system_token_for_local_dev
CALLBACK_URL_BASE=http://backend-dev:8000

# ---- Object storage (S3 / MinIO) ----
S3_ENDPOINT_URL="http://minio:9000"
S3_CUSTOM_DOMAIN="http://127.0.0.1:9000"
S3_ACCESS_KEY_ID="minioadmin"
# [SECRET]
S3_SECRET_ACCESS_KEY=change-me
S3_BUCKET_NAME="voicebot-local-bucket"
S3_REGION_NAME="us-east-1"

# ---- Celery (optional; default derives from REDIS_HOST/PORT on db /2) ----
# CELERY_BROKER_URL=redis://redis:6379/2
# CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---- Production hardening (only under config.settings.production) ----
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True


# =============================================================================
#  3. Scheduling & Booking  (optional; all default OFF/safe if blank)
# =============================================================================
# ---- Booking behaviour ----
BOOKING_HOLD_TTL_SECONDS=300
BOOKING_REMINDER_OFFSETS_MINUTES=1440,60
BOOKING_RESCHEDULE_TOKEN_TTL_HOURS=72
EXTERNAL_FREEBUSY_CACHE_SECONDS=60

# ---- Calendar OAuth token encryption (REQUIRED before any calendar connect) ----
# [SECRET] Fernet key. Generate:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SCHEDULING_TOKEN_ENCRYPTION_KEY=

# ---- Google Calendar (docs/external-app-creds/02-google-calendar.md) ----
GOOGLE_CALENDAR_CLIENT_ID=
# [SECRET]
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/api/v1/core/calendar-integrations/callback/
# Optional public HTTPS webhook URL; blank = on-demand free/busy only.
GOOGLE_CALENDAR_WEBHOOK_URL=

# ---- Microsoft 365 / Outlook (docs/external-app-creds/03-outlook-microsoft-365.md) ----
MICROSOFT_CALENDAR_CLIENT_ID=
# [SECRET]
MICROSOFT_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_REDIRECT_URI=http://localhost:8000/api/v1/core/calendar-integrations/callback/
# Optional. "common" = work + personal; "organizations" = work only; or a tenant id.
MICROSOFT_CALENDAR_AUTHORITY=https://login.microsoftonline.com/common
# Optional public HTTPS webhook URL; blank = on-demand free/busy only.
MICROSOFT_CALENDAR_WEBHOOK_URL=
# Optional. Graph API base; rarely changed.
MICROSOFT_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0

# ---- Firebase Cloud Messaging / push (docs/external-app-creds/01-firebase-fcm.md) ----
# Filesystem PATH to the Firebase service-account JSON. Blank = push disabled.
FIREBASE_CREDENTIALS=
