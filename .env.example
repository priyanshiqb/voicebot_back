# =============================================================================
#  .env  —  BASE / SHARED configuration for the whole stack
# -----------------------------------------------------------------------------
#  Copy to `.env` and replace every value marked [SECRET]. Never commit `.env`.
#
#  WHO READS THIS FILE
#    - docker compose  reads it for `${VAR}` interpolation in docker-compose/*.yml
#    - Django          reads it through django-environ (config/settings/base.py)
#    Section 1 below is compose-only. Section 2 is Django. A handful of keys are
#    used by both and are called out where they appear.
#
#  LOAD ORDER (config/settings/base.py, lines 14-26)
#    1. `.env.local`   (or whatever $ENV_FILE names)   ← read FIRST
#    2. `.env`         (this file)                     ← read SECOND
#    django-environ KEEPS THE FIRST VALUE IT SEES, so anything in `.env.local`
#    OVERRIDES the same key here. See `.env.local.example`.
#
#  SYNTAX RULES
#    - Keep every comment on its OWN line. django-environ folds a trailing
#      "VALUE  # note" into the value itself.
#    - No spaces around `=`.
#    - Booleans: True/False, true/false, 1/0, yes/no all parse.
#    - Lists: comma-separated, no brackets, no spaces (a,b,c).
#    - In docker-compose values a literal `$` must be written `$$`.
#
#  ANNOTATION LEGEND  (first thing in every description)
#    [REQUIRED]     No default in settings. Django raises ImproperlyConfigured
#                   and refuses to boot if this is missing. 11 keys in total.
#    [default: X]   Safe to delete the line — X is what settings will use.
#    [no default]   Optional, but settings has no fallback; blank disables it.
#    [SECRET]       Replace before use. Never commit the real value.
#    [compose-only] Interpolated by docker compose; Django never reads it.
#    [prod-only]    Only read under config.settings.production.
# =============================================================================



# #############################################################################
#
#   SECTION 1  —  DOCKER / COMPOSE STACK
#
#   Everything here is consumed by `docker compose` when it renders
#   docker-compose.yml and the fragments it includes from docker-compose/.
#   None of it reaches Django. If you run the app on the host instead of in
#   containers, you can ignore this entire section.
#
# #############################################################################

# -----------------------------------------------------------------------------
#  1.1  Compose project & profiles
# -----------------------------------------------------------------------------
# [compose-only] Prefix for container, network and volume names. Two checkouts
# with different values can run side by side without colliding.
# Values: lowercase letters, digits, dash, underscore.
# Example: voicebot_back
COMPOSE_PROJECT_NAME=voicebot_back

# [compose-only] Which service groups `docker compose up` starts. A service
# whose profile is absent is not created at all.
# Values (comma-separated, defined in docker-compose/*.yml):
#   dev                 backend-dev + celery-dev + celery-beat-dev (daphne, autoreload)
#   prod                backend-wsgi + backend-asgi + celery-prod + beat (gunicorn)
#   database            postgres
#   pgbouncer           pgbouncer connection pooler in front of postgres
#   pgexporter          postgres metrics exporter for Prometheus
#   caches              redis
#   redis-insight       RedisInsight web UI
#   redis-exporter      redis metrics exporter for Prometheus
#   gateway             caddy reverse proxy (ports 80/443)
#   emulators           azurite (Azure Blob emulator)
#   grafana             grafana dashboards
#   logs-monitoring     loki + alloy
#   matrics-monitoring  prometheus  (spelled this way in the compose files)
#   pgadmin             pgAdmin web UI
#   backend-docs        nginx serving ./docs
# Example (a normal dev box): the line below.
COMPOSE_PROFILES=dev,database,pgbouncer,caches,grafana,logs-monitoring,matrics-monitoring,emulators,backend-docs

# -----------------------------------------------------------------------------
#  1.2  Where published ports are bound
# -----------------------------------------------------------------------------
# [compose-only] Host interface every published port binds to. 127.0.0.1 keeps
# the stack reachable only from this machine; 0.0.0.0 exposes it to the LAN.
# Values: 127.0.0.1 | 0.0.0.0 | a specific host IP.
# Example: 127.0.0.1
BIND_IP=127.0.0.1

# [compose-only] [default: $BIND_IP] Per-service overrides, for the case where
# one service must be reachable from outside but the rest must not. Uncomment
# only the ones you need.
# Values: same as BIND_IP.
# BACKEND_DEV_BIND_IP=127.0.0.1
# BACKEND_WSGI_BIND_IP=127.0.0.1
# BACKEND_ASGI_BIND_IP=127.0.0.1
# POSTGRES_BIND_IP=127.0.0.1
# REDIS_BIND_IP=127.0.0.1
# REDIS_INSIGHT_BIND_IP=127.0.0.1
# PGADMIN_BIND_IP=127.0.0.1
# GRAFANA_BIND_IP=127.0.0.1
# LOKI_BIND_IP=127.0.0.1
# PROMETHEUS_BIND_IP=127.0.0.1
# AZURITE_BIND_IP=127.0.0.1
# DOCS_BIND_IP=127.0.0.1

# -----------------------------------------------------------------------------
#  1.3  Caddy gateway & public domain  (profile: gateway)
# -----------------------------------------------------------------------------
# These four are substituted into docker-config/Caddyfile.
#
# [compose-only] URL scheme Caddy serves on. "https://" makes Caddy request a
# real certificate for $DOMAIN, which needs that domain to resolve to this host.
# Values: "http://" | "https://"   (keep the quotes and the trailing slashes)
# Example: "http://"
SCHEME="http://"

# [compose-only] Public hostname Caddy answers for.
# Values: any hostname. Use localhost for a dev box.
# Example: api.voicebot.com
DOMAIN=localhost

# [compose-only] Environment label used in the Caddyfile's site block.
# Values: dev | staging | prod
# Example: dev
ENV_NAME=dev

# [compose-only] Container names Caddy proxies to. Under the `dev` profile both
# point at the single backend-dev container; under `prod` they are the separate
# gunicorn and daphne services.
# Values: dev profile -> backend-dev / backend-dev
#         prod profile -> backend-wsgi / backend-asgi
WSGI_HOST=backend-dev
ASGI_HOST=backend-dev

# [compose-only] Contact address Let's Encrypt registers for expiry warnings.
# Only used when SCHEME is https://.
# Values: a real, monitored mailbox.
# Example: admin@voicebot.com
ACME_EMAIL=admin@example.com

# [compose-only] HTTP basic auth on the gateway's protected routes.
# Values: any username.
# Example: admin
GATEWAY_BASIC_AUTH_USER=admin

# [compose-only] [SECRET] bcrypt HASH of the password, not the password.
# Generate: docker run --rm caddy:2.7-alpine caddy hash-password --plaintext 'yourpass'
# Then double every "$" -> "$$", because compose treats a single $ as
# interpolation and will mangle the hash.
# Example: $$2a$$14$$Zt1s...  (truncated)
GATEWAY_BASIC_AUTH_PASSWORD_HASH=change-me-escaped-bcrypt-hash

# -----------------------------------------------------------------------------
#  1.4  Application ports published on the host
# -----------------------------------------------------------------------------
# [compose-only] Host port for the dev container's daphne (ASGI, serves HTTP and
# WebSockets together). This is the one you open in a browser during dev.
# Values: any free port 1024-65535.
# Example: 8000
DAPHNE_PORT=8000

# [compose-only] Host ports for the prod profile's two backends: gunicorn (WSGI,
# plain HTTP) and daphne (ASGI, WebSockets). Unused under the dev profile.
# Values: any free ports.
# Example: 8001 / 8002
WSGI_PORT=8001
ASGI_PORT=8002

# [compose-only] [default: 8088] Host port for the Caddy container that serves
# ./docs (profile: backend-docs).
# Values: any free port.
# Example: 8088
DOCS_PORT=8088

# [compose-only] HTTP basic auth on the documentation portal.
#
# The docs container enforces this ITSELF rather than relying on the gateway,
# because the port above is published straight onto the host — traffic to
# 127.0.0.1:8088 never passes through Caddy's gateway routes, so a rule there
# would protect docs.<domain> and leave the port wide open.
#
# FAILS CLOSED: with no valid hash the container refuses to start. A docs portal
# that silently comes up unauthenticated is the outcome this prevents.
#
# [default: GATEWAY_BASIC_AUTH_USER] so an existing deployment still starts.
# Set a distinct value if documentation readers should NOT also hold the
# Prometheus / Loki / RedisInsight credential.
# Values: any username.
# Example: docs
DOCS_BASIC_AUTH_USER=

# [default: GATEWAY_BASIC_AUTH_PASSWORD_HASH] [SECRET] bcrypt HASH, not the
# password.
# Generate: docker run --rm caddy:2.7-alpine caddy hash-password --plaintext 'yourpass'
# Then double every "$" -> "$$", because compose treats a single $ as
# interpolation and will mangle the hash.
# Example: $$2a$$14$$Zt1s...  (truncated)
DOCS_BASIC_AUTH_PASSWORD_HASH=

# -----------------------------------------------------------------------------
#  1.5  Postgres, pgbouncer & pgAdmin  (profiles: database, pgbouncer, pgadmin)
# -----------------------------------------------------------------------------
# The postgres container creates its database from POSTGRES_DB / POSTGRES_USER /
# POSTGRES_PASSWORD, and pgbouncer + postgres-exporter reuse the same three.
# Those live in section 2.5 because Django requires them too.
#
# [compose-only] Host port that maps to the container's 5432. This is what you
# point DBeaver / psql at, and what `.env.local` uses for host-side app runs.
# It is deliberately NOT 5432, so it cannot collide with a local Postgres.
# Values: any free port.
# Example: 5579
DB_PORT=5579

# [compose-only] pgAdmin web UI (profile: pgadmin).
# Values: PGADMIN_PORT any free port; PGADMIN_EMAIL is the login and must look
# like a real address or pgAdmin refuses to start.
# Example: 5560 / admin@example.com
PGADMIN_PORT=5560
PGADMIN_EMAIL=admin@example.com

# [compose-only] [SECRET] pgAdmin login password.
# Values: any non-empty string.
PGADMIN_PASSWORD=change-me

# -----------------------------------------------------------------------------
#  1.6  Redis  (profiles: caches, redis-insight)
# -----------------------------------------------------------------------------
# [compose-only] Host port mapping to Redis' in-container 6379. Host-side app
# runs must set REDIS_PORT to THIS value in .env.local — see section 2.6.
# Values: any free port.
# Example: 5563
REDIS_EXTERNAL_PORT=5563

# [compose-only] Host port for the RedisInsight UI (profile: redis-insight).
# Values: any free port.
# Example: 5561
REDIS_INSIGHT_PORT=5561

# -----------------------------------------------------------------------------
#  1.7  Azurite — local Azure Blob emulator  (profile: emulators)
# -----------------------------------------------------------------------------
# The local object store. Section 2.8 points the app at it.
#
# Credentials are Azurite's built-in development account, not variables — they
# are fixed constants, already copied into section 2.8:
#   AccountName  devstoreaccount1
#   AccountKey   Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==
# They are public and documented by Microsoft; they are not a secret to protect.
# The cost of fixed constants is that app and emulator CAN drift, which MinIO's
# reuse of S3_ACCESS_KEY_ID made impossible — if uploads start failing with 403,
# check section 2.8 against these two lines first.
#
# The container itself is not created for you. Once Azurite is up:
#   az storage container create --name voicebot-local
#       --connection-string "$AZURE_CONNECTION_STRING"
#
# Azurite has no web console. Browse local blobs with Azure Storage Explorer or
# `az storage blob list --connection-string ...`.
#
# Known trap: a stale .data/azurite directory from an earlier run makes the
# container restart-loop with "Critical error happens during GC". Delete the
# directory — it is disposable.
#
# [compose-only] [default: 10000] Blob API port. Queue (10001) and table (10002)
# are not started — nothing here uses them.
# Values: any free port.
# Example: 10000
AZURITE_BLOB_PORT=10000

# -----------------------------------------------------------------------------
#  1.8  Observability  (profiles: grafana, logs-monitoring, matrics-monitoring)
# -----------------------------------------------------------------------------
# [compose-only] Grafana admin login, created on first boot only. Changing these
# later does nothing unless you also delete .data/grafana.
# Values: any username / any password.
# Example: admin
GF_SECURITY_ADMIN_USER=admin

# [compose-only] [SECRET] Grafana admin password.
GF_SECURITY_ADMIN_PASSWORD=change-me

# [compose-only] Host ports for the three observability UIs.
# Values: any free ports.
# Example: 3099 / 3100 / 9090
GRAFANA_PORT=3099
LOKI_PORT=3100
PROMETHEUS_PORT=9090

# [compose-only] [default: 720h] How long Loki keeps ingested log lines.
# Values: a Go duration, hours are the practical unit (720h = 30 days).
# Example: 720h
LOKI_RETENTION_PERIOD=720h

# -----------------------------------------------------------------------------
#  1.9  ETL host alias  (dev + prod backend containers)
# -----------------------------------------------------------------------------
# [compose-only] [default: dummy-local-host -> 127.0.0.1] Adds an /etc/hosts
# entry inside every backend and celery container, so a production ETL hostname
# can be pointed at a local process during development. Leave both unset unless
# you are actually doing that — the defaults are inert.
# Values: ETL_DOMAIN a hostname; LOCAL_DNS_ROUTING_IP an IP reachable from
# inside the container (host.docker.internal on Docker Desktop).
# Example: etl.voicebot.com / 192.168.1.20
# ETL_DOMAIN=dummy-local-host
# LOCAL_DNS_ROUTING_IP=127.0.0.1



# #############################################################################
#
#   SECTION 2  —  DJANGO APPLICATION
#
#   Read by django-environ in config/settings/base.py (plus local.py and
#   production.py where noted). Every key below reaches the app whether it runs
#   in Docker or on the host.
#
#   The 11 keys marked [REQUIRED] have no default: Django will not start
#   without them. Everything else can be deleted and will fall back.
#
# #############################################################################

# -----------------------------------------------------------------------------
#  2.1  Core Django
# -----------------------------------------------------------------------------
# [default: config.settings.local] Which settings module to load. Read from the
# process environment by manage.py / asgi.py / celery.py, and passed into the
# containers by compose (which defaults it to .production under the prod profile).
# Values: config.settings.local      dev — verbose logging, SQLite under `test`
#         config.settings.production HTTPS redirect, HSTS, JSON logs, secure cookies
#         config.settings.test_postgres  test runs that need real Postgres
#         config.settings.base       bare; rarely what you want
# Example: config.settings.local
DJANGO_SETTINGS_MODULE=config.settings.local

# [default: .env.local] Which override file is read BEFORE this one.
# Must be set in the real process environment (`export ENV_FILE=...`) — setting
# it inside a .env file is too late, because base.py reads it to decide which
# file to open. The special value ".env" skips the override step entirely.
# Values: a filename relative to the repo root.
# Example: .env.local
# ENV_FILE=.env.local

# [default: False] Django's debug mode. Leaks stack traces and settings on error,
# so it must be False anywhere the app is reachable by anyone else.
# Values: True | False
# Example: True on a dev box, False everywhere else.
DJANGO_DEBUG=True

# [REQUIRED] [SECRET] Signs sessions, CSRF tokens, password-reset links AND all
# JWTs (SIMPLE_JWT reuses it as SIGNING_KEY). Rotating it logs everyone out.
# Generate: python -c "import secrets;print(secrets.token_urlsafe(64))"
# Values: 50+ random characters.
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret

# [default: empty list] Host headers Django will answer to. localhost,
# 127.0.0.1, backend-wsgi, backend-asgi and the hostname of BACKEND_PROJECT_URL
# are appended automatically, so a minimal deployment can leave this unset.
# Values: comma-separated hostnames. "*" allows any host — dev only; it disables
# the Host-header check that blocks cache-poisoning and password-reset spoofing.
# Example: api.voicebot.com,voicebot.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,*

# [REQUIRED] Public base URL of THIS backend. Its hostname is auto-added to
# ALLOWED_HOSTS, and it is added to CORS and CSRF trusted origins.
# Values: absolute URL, scheme included, no trailing slash.
# Example: https://api.voicebot.com
BACKEND_PROJECT_URL=http://localhost:8000

# [REQUIRED] Public base URL of the frontend. Doubles as the default for both
# CORS_ALLOWED_ORIGINS and CSRF_TRUSTED_ORIGINS, and is where the calendar OAuth
# callback redirects the user back to.
# Values: absolute URL, scheme included, no trailing slash.
# Example: https://app.voicebot.com
FRONTEND_PROJECT_URL=http://localhost:3000

# [default: FRONTEND_PROJECT_URL] Browser origins allowed to call this API.
# FRONTEND_PROJECT_URL and BACKEND_PROJECT_URL are always appended, so listing
# them here is optional — this is for ADDITIONAL origins.
# Values: comma-separated absolute origins (scheme + host + port, no path).
# Example: http://localhost:3000,https://staging.voicebot.com
CORS_ALLOWED_ORIGINS=http://localhost:3000

# [default: FRONTEND_PROJECT_URL + BACKEND_PROJECT_URL] Origins trusted for
# unsafe (POST/PUT/DELETE) requests carrying a CSRF cookie — the Django admin
# and the two-factor login pages. Both project URLs are always appended.
# Values: comma-separated absolute origins.
# Example: https://api.voicebot.com
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# [default: False] [config.settings.local only] Accept ANY browser origin.
# A blunt dev convenience that overrides CORS_ALLOWED_ORIGINS entirely; it is
# ignored under config.settings.production.
# Values: True | False
CORS_ALLOW_ALL_ORIGINS=True

# -----------------------------------------------------------------------------
#  2.2  Logging  (config.settings.local only)
# -----------------------------------------------------------------------------
# [default: False / False] Console log format. JSON wins if both are True;
# with both False you get the verbose format that includes module, file and line.
# Production ignores these and always emits JSON.
# Values: True | False
#   DJANGO_JSON_LOGGING=True    one JSON object per line — for Loki/Alloy
#   DJANGO_SIMPLE_LOGGING=True  "[LEVEL] time - message", easiest to read
DJANGO_JSON_LOGGING=False
DJANGO_SIMPLE_LOGGING=True

# -----------------------------------------------------------------------------
#  2.3  Production hardening  [prod-only]
# -----------------------------------------------------------------------------
# Read only under config.settings.production. All four already default to the
# secure value, so this block exists to let you TEMPORARILY relax one — e.g.
# turning the SSL redirect off while a load balancer terminates TLS itself.
#
# [prod-only] [default: True] 301-redirect every http:// request to https://.
# Values: True | False
SECURE_SSL_REDIRECT=True

# [prod-only] [default: 31536000] Strict-Transport-Security max-age in seconds
# (31536000 = 1 year). Browsers cache this, so a wrong value is hard to undo —
# start at 3600 when first enabling HTTPS, then raise it.
# Values: seconds; 0 disables the header.
SECURE_HSTS_SECONDS=31536000

# [prod-only] [default: True] Apply HSTS to every subdomain. Only turn this on
# once EVERY subdomain serves HTTPS — it will break any that does not.
# Values: True | False
SECURE_HSTS_INCLUDE_SUBDOMAINS=True

# [prod-only] [default: True] Add the `preload` directive, making the domain
# eligible for browsers' built-in HSTS list. Effectively permanent once
# submitted — removal takes months.
# Values: True | False
SECURE_HSTS_PRELOAD=True

# -----------------------------------------------------------------------------
#  2.4  Security & anti-abuse
# -----------------------------------------------------------------------------
# [default: False] Enables config.middleware.ReCaptchaMiddleware on the signup,
# OTP and password-reset paths listed in base.py:335.
# NOTE: token verification is NOT implemented yet (middleware.py:97) — the
# middleware reads the X-ReCaptcha-Token header and lets every request through.
# Turning this on today changes nothing; it does not yet need a secret key.
# Values: True | False
RECAPTCHA_VERIFICATION_ON=True

# [default: 2] Minutes a signup / password-reset OTP stays valid.
# Values: positive integer. Under ~2 makes slow mail delivery unusable; over ~10
# widens the window for a guessed code.
# Example: 2
OTP_VALIDITY_MINUTES=2

# -----------------------------------------------------------------------------
#  2.5  Database  —  PostgreSQL
# -----------------------------------------------------------------------------
# All five are [REQUIRED]. The postgres, pgbouncer and postgres-exporter
# containers also read DB / USER / PASSWORD (section 1.5).
#
# [REQUIRED] Database name. Test runs create and drop `test_<this>` alongside it;
# the real database is never touched by the suite.
# Values: any valid identifier.
# Example: voicebot_db
POSTGRES_DB=voicebot_db

# [REQUIRED] Role Django connects as. Needs CREATEDB to run the test suite.
# Values: any Postgres role name.
# Example: postgres
POSTGRES_USER=postgres

# [REQUIRED] [SECRET] Password for that role.
POSTGRES_PASSWORD=change-me

# [REQUIRED] Host Django dials.
# Values: pgbouncer  in Docker with the pgbouncer profile (pooled — preferred)
#         postgres   in Docker, straight to the database
#         127.0.0.1  running Django on the host (set this in .env.local)
# Example: pgbouncer
POSTGRES_HOST=pgbouncer

# [REQUIRED] Port on POSTGRES_HOST. This is the IN-CONTAINER port; both postgres
# and pgbouncer listen on 5432 inside the network. Running Django on the host
# instead means using the published port ($DB_PORT, 5579) — that override
# belongs in .env.local, not here.
# Values: 5432 in Docker | $DB_PORT on the host
# Example: 5432
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
#  2.6  Redis  —  cache, channel layer, Celery broker, brute-force counters
# -----------------------------------------------------------------------------
# One Redis server, three logical databases: /1 cache + django-defender,
# /2 Celery broker and results, and the channel layer (no db suffix).
#
# [REQUIRED] Redis hostname.
# Values: redis      in Docker (the service name)
#         127.0.0.1  running Django on the host (set this in .env.local)
# Example: redis
REDIS_HOST=redis

# [REQUIRED] Port on REDIS_HOST. In-container this is 6379. On the host it is
# the PUBLISHED port ($REDIS_EXTERNAL_PORT, 5563) — a mismatch here is the most
# common cause of a connection refused on a host-side run.
# Values: 6379 in Docker | $REDIS_EXTERNAL_PORT on the host
# Example: 6379
REDIS_PORT=6379

# -----------------------------------------------------------------------------
#  2.7  Celery  —  background workers and the beat scheduler
# -----------------------------------------------------------------------------
# [default: redis://$REDIS_HOST:$REDIS_PORT/2] Broker and result backend. Both
# derive from the Redis settings above, so set them only to point Celery at a
# DIFFERENT server or database than the cache.
# Values: a redis:// URL (or amqp:// for RabbitMQ).
# Example: redis://redis:6379/2
# CELERY_BROKER_URL=redis://redis:6379/2
# CELERY_RESULT_BACKEND=redis://redis:6379/2

# -----------------------------------------------------------------------------
#  2.8  Object storage  —  Azure Blob
# -----------------------------------------------------------------------------
# Azure Blob is used only when ACCOUNT_NAME **and** ACCOUNT_KEY **and**
# CONTAINER are all set. Miss any one and Django silently falls back to local
# disk storage under ./media — which loses every upload on a container restart.
# `manage.py check` warns about exactly that (core.W002) outside DEBUG.
#
# For local development point all of this at Azurite (section 1.7) using its
# fixed development account. For a real account, take the name and key from
# Storage account → Security + networking → Access keys in the portal.
#
# The storage ACCOUNT also needs CORS, because browsers upload straight to it:
#   az storage cors add --account-name <acct> --services b
#       --methods PUT GET HEAD OPTIONS
#       --origins "https://app.example.com"
#       --allowed-headers "x-ms-blob-type,content-type"
#       --exposed-headers "*" --max-age 3600
# Leaving x-ms-blob-type out of --allowed-headers fails the preflight, and the
# browser error does not say which header was rejected.

# [no default] Storage account name.
# Values: an Azure storage account | devstoreaccount1 for Azurite.
# Example: voicebotstorage
AZURE_ACCOUNT_NAME="devstoreaccount1"

# [no default] [SECRET] Shared account key. Required even when a connection
# string is set: signing the upload and download SAS needs the key itself. A
# managed identity can serve django-storages but cannot sign a service SAS
# without first fetching a user delegation key, which is not implemented.
# Values: the base64 access key from the portal.
# Azurite's is the well-known public development key below — not a secret.
AZURE_ACCOUNT_KEY="Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw=="

# [no default] Container holding knowledge-base files, catalog media, call
# recordings and contact imports. Must already exist — nothing creates it.
# Create it locally with:
#   az storage container create --name voicebot-local
#       --connection-string "$AZURE_CONNECTION_STRING"
# Values: a valid container name (lowercase, 3-63 chars).
# Example: voicebot-local
AZURE_CONTAINER="voicebot-local"

# [no default] Full connection string. Optional for a real account, whose
# endpoint is derived from the account name. REQUIRED for Azurite, which puts
# the account in the URL path rather than in the subdomain.
# Values: a storage connection string.
AZURE_CONNECTION_STRING="DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;"

# [default: core.windows.net] Endpoint suffix. Only differs on sovereign clouds
# (core.chinacloudapi.cn, core.usgovcloudapi.net). Ignored when a connection
# string supplies the endpoint.
# Values: an Azure endpoint suffix.
# AZURE_ENDPOINT_SUFFIX="core.windows.net"

# [no default] Public host that signed URLs are rewritten to — a CDN, or a
# browser-reachable address where the in-container endpoint is not one. Needed
# locally because a browser cannot resolve the `azurite` compose hostname.
#
# Safe to rewrite, unlike under S3: a service SAS signs the resource path and
# not the Host header, so swapping the host does not invalidate the signature.
# Only scheme and host are replaced — the path, including Azurite's
# /devstoreaccount1 prefix, is preserved.
# Values: URL or bare host; the scheme, if given, is preserved.
# Example: cdn.voicebot.com
AZURE_PUBLIC_ENDPOINT="http://localhost:10000"

# [default: 30] Days an EXPIRED login session is kept before deletion, measured
# from expiry rather than creation.
# Rows in `user_sessions` hold an IP address and a device name, so this is a
# privacy window before a disk one — a 7-day session removed 30 days after it
# expired stayed visible for 37, which is what an "unrecognised device"
# investigation needs. Nothing else prunes the table.
# The same daily task also runs SimpleJWT's `flushexpiredtokens`: with refresh
# rotation on, every token refresh blacklists a row and nothing removed them.
# Values: positive integer days.
# Example: 30
USER_SESSION_RETENTION_DAYS=30

# [default: 5000] Rows deleted per chunk by that sweep, so one run cannot take a
# table-wide lock or build a DELETE with a million ids in it.
# Example: 5000
USER_SESSION_PURGE_BATCH=5000

# [default: 60] Seconds a POSITIVE session check is trusted without re-reading the
# row. This is what keeps an authenticated request from costing a database query.
# Deliberately short, and deliberately not the token lifetime: logout and refresh
# rotation both write a "revoked" marker and so take effect immediately, but a
# revocation that bypasses them — an admin edit, a bulk update, direct SQL — stays
# invisible for at most this long. Raising it trades revocation latency for fewer
# queries.
# Values: positive integer seconds.
# Example: 60
SESSION_CACHE_TTL_SECONDS=60

# [default: True] Check an uploaded object's leading bytes against the extension it
# claims, at confirm time. Costs one ranged GET of 64 bytes per confirm.
# Both `content_type` and the filename extension are client strings — the allowlists
# check the string, never the file, so a .png holding a PDF passes both without this.
# Only a POSITIVE contradiction rejects: a file that cannot be identified, or one
# whose extension has no signature (.txt, .csv), is allowed through. Failing to
# recognise a file is not evidence against it.
# NOT malware scanning — it answers "is this the kind of file you said", not "is
# this file safe".
# Values: True | False. Turn off only if a legitimate format is being rejected.
# Example: True
UPLOAD_VERIFY_CONTENT=True

# [default: PUT] How a presigned upload ticket is issued.
# Values:
#   POST  Browser form upload. The per-flow size ceiling is signed into the policy
#         as a `content-length-range` condition, so the object store refuses an
#         oversize body DURING the upload. This is the only mode in which the size
#         limit is actually a limit.
#   PUT   Single presigned PUT. Simpler for the client but unbounded — a ticket
#         issued for a 1 MB file will accept a 500 MB one, and the overage is only
#         found at confirm-upload, after the bytes have been transferred and stored.
# Defaults to PUT because POST is a BREAKING CHANGE for the frontend: it must send
# multipart form data with the returned `upload_fields`, file part last, and treat
# 204 as success. Ship both together. Confirm the object store supports POST Object
# first — check Cloudflare R2's current S3 compatibility list. Note that Azure Blob
# has no POST-policy equivalent at all, so this option disappears after the port.
# `manage.py check` emits core.W001 while this is PUT.
# Example: PUT
UPLOAD_PRESIGN_METHOD=PUT

# [default: 15] Minutes an upload ticket stays valid.
# Must stay well below PENDING_UPLOAD_TTL_HOURS, or the abandoned-upload sweep
# deletes rows whose upload is still legitimately in flight and the client confirms
# into a 404. `manage.py check` enforces that relationship (core.E003).
# Values: positive integer minutes.
# Example: 15
UPLOAD_URL_TTL_MINUTES=15

# [default: 24] Hours a reserved-but-unconfirmed upload is kept before the nightly
# sweep deletes the row AND the object behind it.
# Uploads are two-step: the server reserves a PENDING row, hands out a presigned
# PUT, and waits for a confirm. A closed tab between those two is enough to leave
# a file in the bucket that nothing in the product will ever show you again, so
# this value is the only thing bounding that growth.
# Must comfortably exceed the presigned URL lifetime (15 minutes) plus however
# long a slow client might take — set it too low and the sweep deletes an upload
# that is still in flight.
# Values: positive integer hours.
# Example: 24
PENDING_UPLOAD_TTL_HOURS=24

# -----------------------------------------------------------------------------
#  2.9  Platform email (SMTP)
# -----------------------------------------------------------------------------
# This is the PLATFORM sender: signup OTP, email verification and password
# reset always go through it, never through a tenant's own SMTP — a tenant does
# not exist yet at signup, and a tenant whose SMTP breaks must not be locked out
# of the reset flow that would fix it.
#
# [default: ""] Backend class. Empty means Django's global default (SMTP), so
# set it explicitly.
# Values: django.core.mail.backends.smtp.EmailBackend     real delivery
#         django.core.mail.backends.console.EmailBackend  print to stdout (dev)
#         django.core.mail.backends.locmem.EmailBackend   in-memory (tests)
# Example: django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND='django.core.mail.backends.smtp.EmailBackend'

# [default: ""] SMTP server hostname.
# Values: any SMTP host.
# Example: smtp.gmail.com | email-smtp.ap-south-1.amazonaws.com
EMAIL_HOST='smtp.gmail.com'

# [default: ""] SMTP port.
# Values: 587 STARTTLS submission (use with EMAIL_USE_TLS) | 465 implicit TLS
#         | 1025 MailHog/Mailpit. Cloud providers block 25 outbound.
# Example: 587
EMAIL_PORT=587

# [default: ""] Enable STARTTLS.
# CAREFUL — this is read as a STRING, not a boolean (base.py:406), so ANY
# non-empty value is truthy, INCLUDING the literal "False". To turn TLS off you
# must leave the value EMPTY or delete the line. Setting False enables it.
# Values: True to enable | (empty) to disable
# Example: True
EMAIL_USE_TLS=True

# [default: ""] Login username, and the address platform mail is sent from —
# core/tasks.py:42 uses it as the From: address, falling back to
# no-reply@localhost when blank.
# Values: an email address (or an SES/Mailgun SMTP username).
# Example: no-reply@voicebot.com
EMAIL_HOST_USER='you@example.com'

# [default: ""] [SECRET] SMTP password. Gmail requires an App Password here, not
# the account password.
EMAIL_HOST_PASSWORD=change-me

# [default: VoiceBot] Display name shown before the address in the From: header.
# Values: any string.
# Example: Voicebot
EMAIL_SENDER_NAME='Voicebot'

# -----------------------------------------------------------------------------
#  2.10  Tenant-owned SMTP
# -----------------------------------------------------------------------------
# Tenants may store their own SMTP credentials so booking and campaign mail is
# sent from their address. These four bound what a tenant is allowed to point at.
#
# [default: True] Master switch. Off makes every tenant fall back to the
# platform sender above.
# Values: True | False
TENANT_SMTP_ENABLED=True

# [default: 10] Socket timeout in seconds for a tenant's SMTP connection.
# Django's own default is None — which blocks forever, so a host that accepts
# the connection and then goes silent would pin a worker permanently.
# Values: positive integer seconds. 5-30 is sensible.
# Example: 10
TENANT_SMTP_TIMEOUT_SECONDS=10

# [default: 465,587,2525] Ports a tenant may configure. 25 is excluded on
# purpose: AWS, GCP and Azure block it outbound, so allowing it buys a timeout
# instead of an accurate "that port will not work" field error.
# Values: comma-separated ports. 465 implicit TLS, 587 STARTTLS, 2525 fallback.
# Example: 465,587,2525
TENANT_SMTP_ALLOWED_PORTS=465,587,2525

# [default: False] Allow tenant SMTP hosts that resolve to private, loopback,
# link-local, reserved or multicast addresses.
# Tenants supply the hostname the workers dial, which is SSRF by design — the
# default blocks it. Turn on ONLY for local development against MailHog or
# Mailpit on localhost. production.py pins this False and ignores the variable,
# because a control that can be flipped by environment is not a control.
# Values: True | False
TENANT_SMTP_ALLOW_PRIVATE_HOSTS=False

# [default: 5] Test sends per hour PER USER on
# /tenant/email-configurations/{id}/test/. Counts ATTEMPTS, not successes —
# throttling runs before the view, so a rejected login costs the same as a
# delivered message. That is what makes it tight during first-time setup (Gmail
# usually takes a few tries, since it needs an App Password). Raise it while
# working through a provider's setup, then put it back: the endpoint opens
# outbound SMTP connections to a caller-supplied host. A tenant's real budget is
# this number times its user count.
# Values: positive integer.
# Example: 5
SMTP_TEST_THROTTLE_PER_HOUR=5

# -----------------------------------------------------------------------------
#  2.11  Payments  —  Razorpay
# -----------------------------------------------------------------------------
# [default: rzp_test_dummykey] Public key id, also handed to the frontend
# checkout. A key starting rzp_test_ moves no real money.
# Values: rzp_test_... | rzp_live_...
# Example: rzp_test_1a2b3c4d5e6f7g

# [default: dummysecret] [SECRET] Server-side key secret. Never expose it to a
# browser.

# -----------------------------------------------------------------------------
#  2.12  ETL / RAG service
# -----------------------------------------------------------------------------
# The companion service that ingests knowledge-base documents and answers
# retrieval queries.
#
# [REQUIRED] Base URL of the ETL API.
# Values: absolute URL including the API path, with a trailing slash.
# Example: http://etl:5001/api/v1/etl/
ETL_SERVER_URL=http://localhost:5001/api/v1/etl/

# [default: dummy_etl_system_token_for_local_dev] [SECRET] Shared bearer token
# for service-to-service calls. Must match the ETL service's own configuration.
# Values: any opaque string; use a long random one outside dev.
ETL_SYSTEM_TOKEN=dummy_etl_system_token_for_local_dev

# [default: None] Base URL the ETL service calls BACK on when a job finishes.
# It must be reachable from wherever ETL runs, which is why it differs from
# BACKEND_PROJECT_URL: in Docker it is the container name; on the host,
# 127.0.0.1 (set that in .env.local). Blank disables callbacks — jobs then
# complete without ever reporting back.
# Values: absolute URL, no trailing slash.
# Example: http://backend-dev:8000
CALLBACK_URL_BASE=http://backend-dev:8000

# -----------------------------------------------------------------------------
#  2.13  Scheduling & bookings
# -----------------------------------------------------------------------------
# [default: 300] Seconds a tentative hold keeps a slot reserved before
# cleanup_expired_holds releases it. Too short and a caller loses the slot mid
# call; too long and abandoned holds block a busy calendar.
# Values: positive integer seconds.
# Example: 300
BOOKING_HOLD_TTL_SECONDS=300

# [default: 1440,60] When to send booking reminders, in minutes BEFORE the
# start time. The beat task runs every 5 minutes, so offsets finer than that are
# not meaningful.
# Values: comma-separated positive integers. 1440 = 24h, 60 = 1h.
# Example: 1440,60
BOOKING_REMINDER_OFFSETS_MINUTES=1440,60

# [default: 72] Hours a self-service reschedule/cancel link stays valid. The
# link is emailed to the customer and needs no login, so a longer window is a
# longer exposure if the mailbox is compromised.
# Values: positive integer hours.
# Example: 72
BOOKING_RESCHEDULE_TOKEN_TTL_HOURS=72

# [default: 90] How many days of availability windows to keep materialised ahead
# of today. A tenant whose event templates advertise a longer booking horizon
# raises this automatically, capped at EventTemplate.MAX_HORIZON_DAYS. Beyond
# the horizon the engine offers no slots at all, so the daily beat task that
# extends it is not optional.
# Values: positive integer days.
# Example: 90
AVAILABILITY_MATERIALIZE_DAYS=90

# [default: 60] Seconds an external calendar's free/busy response is cached.
# Higher cuts Google API calls but widens the window in which a slot booked
# elsewhere still looks free.
# Values: positive integer seconds.
# Example: 60
EXTERNAL_FREEBUSY_CACHE_SECONDS=60

# -----------------------------------------------------------------------------
#  2.14  Calendar integration  —  Google
# -----------------------------------------------------------------------------
# Setup walkthrough: docs/external-app-creds/02-google-calendar.md
#
# [default: ""] [SECRET] Fernet key encrypting stored OAuth refresh tokens at
# rest. REQUIRED before any calendar can be connected — connecting with this
# blank fails. Rotating it makes every stored token undecryptable and forces
# every tenant to reconnect.
# Generate: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Values: a 44-character url-safe base64 Fernet key.
SCHEDULING_TOKEN_ENCRYPTION_KEY=

# [default: ""] OAuth client id from the Google Cloud console.
# Values: ends in .apps.googleusercontent.com
# Example: 1234567890-abc123.apps.googleusercontent.com
GOOGLE_CALENDAR_CLIENT_ID=

# [default: ""] [SECRET] OAuth client secret.
# Values: usually starts GOCSPX-
GOOGLE_CALENDAR_CLIENT_SECRET=

# [default: ""] OAuth redirect URI. Must match an Authorised redirect URI in the
# Google console EXACTLY — scheme, host, port and trailing slash included.
# Values: $BACKEND_PROJECT_URL + /api/v1/core/calendar-integrations/callback/
# Example: http://localhost:8000/api/v1/core/calendar-integrations/callback/
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/api/v1/core/calendar-integrations/callback/

# [default: ""] Public HTTPS URL Google pushes calendar-change notifications to.
# Google will not register a watch channel on a non-public or non-HTTPS address,
# so local work needs a tunnel (ngrok, VS Code Dev Tunnels). Blank disables
# webhooks; the system then falls back to on-demand free/busy lookups, which
# still work — they are just slower and cost an API call per check.
# Values: absolute https:// URL.
# Example: https://<tunnel>/api/v1/core/calendar-webhook/google/
GOOGLE_CALENDAR_WEBHOOK_URL=

# -----------------------------------------------------------------------------
#  2.15  Push notifications  —  Firebase Cloud Messaging
# -----------------------------------------------------------------------------
# Setup walkthrough: docs/external-app-creds/01-firebase-fcm.md
#
# [default: ""] The Firebase service-account credential. Two accepted forms:
#   1. A filesystem PATH to the JSON file  <- preferred
#   2. The JSON itself, inline (any value starting with "{")
# A path keeps the private key out of the environment and out of
# `docker compose config` output; use inline JSON only where your platform
# offers no file mount. In Docker a path must be mounted into the container.
#
# Blank disables push entirely: sends become silent no-ops rather than errors.
# A value that is set but unloadable is NOT silent — it is logged at error level
# and reported by POST /api/v1/core/device-tokens/test/ as configuration_error.
#
# Values: absolute or repo-relative path to a readable .json file, or the JSON.
# Example: /run/secrets/firebase-service-account.json
FIREBASE_CREDENTIALS=

# --- Device token lifecycle ---
# An FCM registration token has no expiry and cannot be validated offline, so
# reachability is inferred from how recently the client re-registered it. Clients
# are expected to POST /core/device-tokens/ on every app start; on web that is the
# ONLY way a rotated token is ever reported. Full model:
# docs/flows/push-notifications.md
#
# [default: 60] Days without a re-registration before a token stops receiving
# pushes. Google's own staleness guidance is ~2 months; FCM itself reaps app
# instances at ~270 days. Raising this sends to more devices that are probably
# gone; lowering it risks skipping a live device whose client checks in rarely.
# Values: positive integer (days).
# Example: 60
DEVICE_TOKEN_STALE_DAYS=

# [default: 90] Days a dead token row is kept before deletion, measured from last
# contact. Only inactive or soft-deleted rows are ever deleted — an active row is
# demoted first, so a device is always visible as inactive for a full window
# before it disappears. Without this the table grows forever.
# Values: positive integer (days).
# Example: 90
DEVICE_TOKEN_RETENTION_DAYS=

# [default: 20] Maximum live registrations per user per tenant. The oldest are
# retired when a new one pushes past the cap. A human has a handful of devices; a
# looping client has thousands.
# Values: positive integer.
# Example: 20
DEVICE_TOKEN_MAX_PER_USER=

# [default: 3] Consecutive INVALID_ARGUMENT failures before a token is retired.
# Not 1: FCM returns that error for a malformed *message* as well as a malformed
# token, so retiring on the first one would let a single bad payload wipe out
# every device it was sent to.
# Values: positive integer.
# Example: 3
DEVICE_TOKEN_FAILURE_STRIKES=

# [default: 5000] Rows deleted per batch by the retention purge, so one run cannot
# take a table-wide lock.
# Values: positive integer.
# Example: 5000
DEVICE_TOKEN_PURGE_BATCH=

# [default: "60/hour"] Rate limit on device registration, per user. Applies only
# to the register call — reads are not throttled. Clients POST on every app start,
# which makes legitimate volume look like abuse, so this is deliberately loose.
# Values: DRF throttle rate, "<number>/<second|minute|hour|day>".
# Example: 60/hour
DEVICE_TOKEN_REGISTER_RATE=

# [default: 86400] Seconds FCM should keep retrying a push before dropping it. A
# stale operational alert is worse than none — "booking needs rescheduling"
# arriving three days late is actively misleading.
# Values: positive integer (seconds).
# Example: 86400
PUSH_TTL_SECONDS=

# -----------------------------------------------------------------------------
#  2.16  Log retention  —  notifications
# -----------------------------------------------------------------------------
# NotificationLog rows hold customer email addresses and nothing else prunes
# them, so these are a privacy obligation before a disk one. Rows attached to a
# booking that has not happened yet are never purged regardless of these values:
# deleting one frees its dedup key and would re-arm an already-sent reminder.
#
# [default: 90] Days a delivered notification row is kept.
# Values: positive integer days.
# Example: 90
NOTIFICATION_LOG_RETENTION_DAYS=90

# [default: 180] Days a FAILED row is kept — longer, because it is the only
# trace of a message that never arrived, and it is what someone goes looking for
# when a customer complains weeks later.
# Values: positive integer days, normally >= the value above.
# Example: 180
NOTIFICATION_LOG_FAILED_RETENTION_DAYS=180

# [default: 5000] Rows deleted per batch by the daily purge task. Lower it if
# the purge holds locks long enough to be noticed.
# Values: positive integer.
# Example: 5000
NOTIFICATION_LOG_PURGE_BATCH=5000

# -----------------------------------------------------------------------------
#  2.17  Log retention  —  platform email delivery
# -----------------------------------------------------------------------------
# EmailDeliveryLog rows hold an email address AND the IP of whoever requested
# the message. Retention is per purpose. Nothing here is an idempotency key, so
# unlike NotificationLog above, deleting a row cannot cause a re-send.
#
# [default: 365 / 365] Security-audit records, kept longest: they are the
# evidence someone reaches for after an account is compromised, which is rarely
# the same week it happened.
# Values: positive integer days.
# Example: 365
EMAIL_LOG_PASSWORD_RESET_RETENTION_DAYS=365
EMAIL_LOG_EMAIL_CHANGE_RETENTION_DAYS=365

# [default: 180] Signup OTP records — support data with a shorter useful life.
# Values: positive integer days.
# Example: 180
EMAIL_LOG_SIGNUP_RETENTION_DAYS=180

# [default: 90] Tenant SMTP test sends — operational noise.
# Values: positive integer days.
# Example: 90
EMAIL_LOG_SMTP_TEST_RETENTION_DAYS=90

# [default: 180] Fallback for any purpose not named above.
# Values: positive integer days.
# Example: 180
EMAIL_LOG_DEFAULT_RETENTION_DAYS=180

# [default: 5000] Rows deleted per batch by the daily purge task.
# Values: positive integer.
# Example: 5000
EMAIL_LOG_PURGE_BATCH=5000

# -----------------------------------------------------------------------------
#  2.18  Contacts & contact import
# -----------------------------------------------------------------------------
# [default: IN] Primary market, used to parse phone numbers that are NOT already
# in international form. A number written as "+91..." ignores this and parses on
# its own. Change it if a deployment mainly serves another country.
# Values: ISO-3166 alpha-2 country code, uppercase.
# Example: IN | US | GB | AE
CONTACT_DEFAULT_PHONE_REGION=IN

# [default: 50000] Maximum data rows in one uploaded CSV/XLSX. A file over this
# is rejected at preview, before anything is parsed.
# Values: positive integer.
# Example: 50000
CONTACT_IMPORT_MAX_ROWS=50000

# [default: 10485760] Maximum upload size in BYTES (10 MiB). Keep it at or below
# DATA_UPLOAD_MAX_MEMORY_SIZE, which is hard-coded to 11 MiB in base.py:487 —
# a larger value here would be overruled by Django rejecting the request first.
# Values: positive integer bytes. 10485760 = 10 MiB.
# Example: 10485760
CONTACT_IMPORT_MAX_FILE_BYTES=10485760

# [default: 24] Hours an uploaded-but-uncommitted import session survives before
# the cleanup task discards it and its staged rows.
# Values: positive integer hours.
# Example: 24
CONTACT_IMPORT_SESSION_TTL_HOURS=24

# [default: 3] Concurrent unfinished import sessions allowed per tenant. Stops
# staged rows from piling up when someone uploads repeatedly and never commits.
# Values: positive integer.
# Example: 3
CONTACT_IMPORT_MAX_OPEN_SESSIONS=3

# [default: 1000] Contacts written per bulk_create batch on commit. Larger is
# faster but holds a transaction open longer.
# Values: positive integer.
# Example: 1000
CONTACT_IMPORT_COMMIT_BATCH_SIZE=1000

# [default: 25] Maximum tags on a single contact.
# Values: positive integer.
# Example: 25
CONTACT_MAX_TAGS_PER_CONTACT=25

# -----------------------------------------------------------------------------
#  2.19  Product & service catalog
# -----------------------------------------------------------------------------
# All of these are serializer-level ceilings. The category nesting cap is
# deliberately NOT here: it is enforced by a database CheckConstraint, and a
# constraint built from a runtime setting is frozen into the migration and then
# silently diverges from it. That bound lives in
# core.models.catalog_category.MAX_CATEGORY_DEPTH (currently 3).
#
# [default: INR] Currency assumed when a variant is created without one. Stored
# per variant, so changing this does not touch existing rows.
# Values: ISO-4217 three-letter code, uppercase (lowercase input is accepted and
# upper-cased on save).
# Example: INR | USD | AED
CATALOG_DEFAULT_CURRENCY=INR

# [default: 100] Maximum priced variants under one catalog item.
# Values: positive integer.
# Example: 100
CATALOG_MAX_VARIANTS_PER_ITEM=100

# [default: 25 / 25] Maximum tags, and maximum aliases, on one item. Aliases are
# what the voice runtime matches a caller's words against ("coke" ->
# "Coca-Cola 500 ml"), so this bounds the lookup cost per item.
# Values: positive integer.
# Example: 25
CATALOG_MAX_TAGS_PER_ITEM=25
CATALOG_MAX_ALIASES_PER_ITEM=25

# [default: 8192] Byte ceiling on an item's free-form `attributes` JSON.
# Values: positive integer bytes.
# Example: 8192
CATALOG_MAX_ATTRIBUTE_BYTES=8192

# [default: 10] Maximum images/files attached to one item.
# Values: positive integer.
# Example: 10
CATALOG_MAX_MEDIA_PER_ITEM=10

# [default: 10485760] Maximum size in BYTES of a single catalog media file,
# checked BEFORE a presigned PUT is issued, so an oversize file never reaches
# the bucket. Independent of DATA_UPLOAD_MAX_MEMORY_SIZE — these bytes are
# uploaded straight to S3 and never pass through Django.
# Values: positive integer bytes. 10485760 = 10 MiB.
# Example: 10485760
CATALOG_MAX_MEDIA_BYTES=10485760

# [default: 50] Maximum add-on items linkable to one parent item.
# Values: positive integer.
# Example: 50
CATALOG_MAX_ADD_ONS_PER_ITEM=50

# -----------------------------------------------------------------------------
#  2.20  Campaigns
# -----------------------------------------------------------------------------
# [default: 5000] Maximum contact ids accepted in one campaign create/update
# request body.
# Values: positive integer.
# Example: 5000
CAMPAIGN_MAX_SELECTED_CONTACTS=5000

# [default: 100000] Maximum members a campaign may materialise. Separate from
# the ceiling above because a filter-based audience is resolved server-side and
# never passes through a request body.
# Values: positive integer.
# Example: 100000
CAMPAIGN_MAX_MEMBERS=100000

# [default: 1000] Members written per bulk_create batch during materialisation.
# Values: positive integer.
# Example: 1000
CAMPAIGN_MATERIALIZE_BATCH_SIZE=1000

# [default: 5] Campaigns allowed in RUNNING state at once, per tenant. This is
# what stops one tenant from saturating the outbound call capacity.
# Values: positive integer.
# Example: 5
CAMPAIGN_MAX_CONCURRENT_RUNNING=5

# --- Campaign runner handoff --------------------------------------------------
# When a campaign's audience is frozen, this backend POSTs the campaign id, tenant
# id and handoff id to the voice runner; the runner then pulls /campaign-runner/
# {id}/context/ for the bot config and the audience, and reports outcomes back.
#
# This push is the runner's ONLY way to discover a campaign — /campaign-runner/
# has no list route — so a handoff that never lands is a campaign that never runs.

# [default: false] Master switch. While false, materialisation moves a campaign
# straight to RUNNING exactly as it did before this integration existed and no
# outbound call is made. Turn on once the runner's endpoint is live.
# Values: true | false
# Example: false
CAMPAIGN_RUNNER_NOTIFY_ENABLED=false

# [default: empty] Absolute URL of the runner's campaign-start endpoint. NO
# sensible default exists, and an empty value with notification enabled is a
# misconfiguration that should be loud rather than a nightly connection error.
# Values: absolute http(s) URL.
# Example: http://localhost:5002/api/v1/campaigns/start/
CAMPAIGN_RUNNER_NOTIFY_URL=

# [default: empty] [SECRET] Shared bearer token sent as `Authorization: Bearer`
# on the handoff. Distinct from the VB_AGENT token the runner uses to call back
# into this service — this one authenticates us TO the runner, not the reverse.
# Values: opaque string, agreed with the runner service.
# Example: dummy_campaign_runner_token_for_local_dev
CAMPAIGN_RUNNER_TOKEN=

# [default: 10] Seconds to wait on the handoff POST. Kept short: the body is a
# handful of ids, so a slow response means the runner is unhealthy and retrying
# later beats holding a worker.
# Values: positive integer (seconds).
# Example: 10
CAMPAIGN_RUNNER_TIMEOUT=10

# [default: 20] Minutes a campaign may sit in HANDING_OFF before the sweeper
# re-notifies it. Must stay ABOVE the notify task's own retry budget (five
# retries of exponential backoff, roughly 15 minutes) or the sweeper stacks a
# duplicate task on one that is still retrying.
# Values: positive integer (minutes).
# Example: 20
CAMPAIGN_RUNNER_STALE_HANDOFF_MINUTES=20

# --- Campaign reports ---------------------------------------------------------
# [default: 7] Days a generated report stays downloadable. After that the expiry
# sweep deletes the file from storage and keeps the row as EXPIRED, so "this
# report existed" stays answerable without paying to store it.
# Values: positive integer (days).
# Example: 7
CAMPAIGN_REPORT_RETENTION_DAYS=7

# [default: 500] Members written between progress updates. One UPDATE per member
# would be a hundred thousand writes to move a progress bar.
# Values: positive integer (rows).
# Example: 500
CAMPAIGN_REPORT_PROGRESS_EVERY=500

# [default: 2000] Most members a PDF report lists. A PDF is laid out in memory,
# so it is capped and says so on the page; the Excel report always has everyone.
# Values: positive integer (rows). Roughly 35 rows per landscape page.
# Example: 2000
CAMPAIGN_REPORT_PDF_MAX_ROWS=2000

# [default: 120] Minutes a RUNNING or PENDING report may go without progress —
# worker killed, task never delivered — before the sweep fails it. Measured from
# the last progress write, so a long build still writing rows is safe; it must
# exceed the longest silent stretch (overview aggregates, final save, upload).
# Values: positive integer (minutes).
# Example: 120
CAMPAIGN_REPORT_STALL_MINUTES=120

# [default: 1] Lifetime of a download link. Minted per request, never stored.
# Values: positive integer (hours).
# Example: 1
CAMPAIGN_REPORT_DOWNLOAD_URL_HOURS=1

# [default: 25] Most probing questions the Excel report lists, each as two
# columns (answer summary, positive?). A ceiling nobody should reach: it stops one
# oddly configured bot turning the member sheet into hundreds of columns.
# Values: non-negative integer (0 disables the columns entirely).
# Example: 25
CAMPAIGN_REPORT_MAX_PROBING_QUESTIONS=25

# --- Razorpay -----------------------------------------------------------------
# All three have NO default in settings: an unset credential stops Django from
# booting rather than silently disabling signature verification, which is what the
# old "rzp_test_dummykey" default did.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# The webhook signing secret from the Razorpay dashboard. Required whenever
# PAYMENTS_ALLOW_UNSIGNED is False — without it every genuine webhook is rejected.
RAZORPAY_WEBHOOK_SECRET=

# Accept payment callbacks without verifying their signature, and stub order
# creation. True is correct for local development and required by the test suite.
# NEVER set this outside a dev box: production settings raise ImproperlyConfigured
# on it, and `manage.py check` reports onboard.E001 whenever DEBUG is False.
PAYMENTS_ALLOW_UNSIGNED=True
