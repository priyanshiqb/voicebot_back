# Global configuration block
{
    email {$ACME_EMAIL}
}

# 1. Main Django Backend (API & WebSockets Split Routing)
{$DOMAIN} {
    # Match WebSocket upgrade requests
    @websockets {
        header Connection *Upgrade*
        header Upgrade websocket
    }
    reverse_proxy @websockets {$ASGI_HOST}:8000

    # Default routing for all other HTTP traffic (REST API, Admin UI, etc.)
    reverse_proxy {$WSGI_HOST}:8000

    log {
        output file /var/log/caddy/access.log {
            roll_size 10mb
            roll_keep 3
        }
    }
}

# 2. Database Administration (pgAdmin)
pgadmin.{$DOMAIN} {
    reverse_proxy pgadmin:80
}

# 3. Redis Dashboard (RedisInsight)
redisinsight.{$DOMAIN} {
    reverse_proxy redis-insight:5540
}

# 4. Observability Dashboard (Grafana)
grafana.{$DOMAIN} {
    reverse_proxy grafana:3000
}

# 5. Metrics Engine (Prometheus)
prometheus.{$DOMAIN} {
    reverse_proxy prometheus:9090
}

# 6. Log Engine (Loki)
loki.{$DOMAIN} {
    reverse_proxy loki:3100
}

# 7. Azurite Storage Emulator Services
azurite-blob.{$DOMAIN} {
    reverse_proxy azurite:10000
}
azurite-queue.{$DOMAIN} {
    reverse_proxy azurite:10001
}
azurite-table.{$DOMAIN} {
    reverse_proxy azurite:10002
}
